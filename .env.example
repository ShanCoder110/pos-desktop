# =============================================================================
# Dukan POS — environment template (committed)
# Copy to `.env` for local runs. Never commit `.env`.
# =============================================================================

# --- App (optional overrides; packaged desktop builds use these defaults) ---
# local | staging | production
APP_ENV=local
# info | debug | warn | error — also written to daily files (see LOG_DIR)
LOG_LEVEL=info
# Optional. Default: `./logs` for `npm run backend`, OS app-data `/logs` for packaged Dukan.
# Daily files: dukan-YYYY-MM-DD.txt (kept 10 days; older deleted on boot)
# LOG_DIR=./logs

# --- HTTP API (Axum loopback) ---
API_HOST=127.0.0.1
# Local Vite / `npm run backend` → 38580
# Packaged Dukan desktop (release) → 38581 (so both can run at once)
# Vite UI → 1430 (VITE_PORT)
API_PORT=38580
# VITE_PORT=1430

# --- Database ---
# Absolute or relative path to the SQLite file used by `npm run backend` / `npm run db:*`.
# Tauri desktop mode still uses the OS app-data path unless this is set for the api bin.
DUKAN_DB_PATH=./data/dukan-pos.sqlite3

# --- Auth session TTLs (opaque hashed tokens; not JWT today) ---
# Human durations: Ns | Nm | Nh | Nd (seconds/minutes/hours/days)
ACCESS_TOKEN_EXPIRY=60m
REFRESH_TOKEN_EXPIRY=30d

# --- Frontend (Vite) — public, baked into the client bundle ---
# Only non-secret values. Never put signing keys or service-role keys here.
# Prefer mode files (committed): `.env.development` → :38580, `.env.production` → :38581.
# If you set VITE_API_BASE_URL here, keep it for local only; production builds use `.env.production`.
# VITE_API_BASE_URL=http://127.0.0.1:38580/api/v1
# Frontend log verbosity: debug | info | warn | error
VITE_LOG_LEVEL=debug
# Counter device id (single-shop default until multi-device registration)
VITE_SEED_DEVICE_ID=20000000-0000-4000-8000-000000000003

# --- Cloud sync (future — required only when CLOUD_SYNC_ENABLED=true) ---
CLOUD_SYNC_ENABLED=false
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # Rust/server only — never VITE_
