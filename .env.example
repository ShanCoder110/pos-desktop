# =============================================================================
# Dukan POS — environment template (committed)
# Copy to `.env` for local runs. Never commit `.env`.
# =============================================================================

# --- App ---
# local | staging | production
APP_ENV=local
LOG_LEVEL=info

# --- HTTP API (Axum loopback) ---
API_HOST=127.0.0.1
API_PORT=38472

# --- Database ---
# Absolute or relative path to the SQLite file used by `npm run backend` / `npm run db:*`.
# Tauri desktop mode still uses the OS app-data path unless this is set for the api bin.
DUKAN_DB_PATH=./data/dukan-pos.sqlite3

# --- Auth session TTLs (opaque hashed tokens; not JWT today) ---
# Human durations: Ns | Nm | Nh | Nd (seconds/minutes/hours/days)
ACCESS_TOKEN_EXPIRY=60m
REFRESH_TOKEN_EXPIRY=30d

# --- Staff defaults (local only) ---
# Used when create-user omits password (backend). Prefer setting a real password in UI.
DEFAULT_STAFF_PASSWORD=shan@123

# --- Frontend (Vite) — public, baked into the client bundle ---
# Only non-secret values. Never put signing keys or service-role keys here.
VITE_API_BASE_URL=http://127.0.0.1:38472/api/v1
# Frontend log verbosity: debug | info | warn | error
VITE_LOG_LEVEL=debug
# Shown as default when adding staff without a password (public — require password in UI long-term)
VITE_DEFAULT_STAFF_PASSWORD=shan@123
# Counter device id (single-shop default until multi-device registration)
VITE_SEED_DEVICE_ID=20000000-0000-4000-8000-000000000003

# --- Cloud sync (future — required only when CLOUD_SYNC_ENABLED=true) ---
CLOUD_SYNC_ENABLED=false
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # Rust/server only — never VITE_
