{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dukan",
  "version": "0.1.2",
  "identifier": "com.pos.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dukan",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzdBNDlFNDAyN0Q0ODgKUldTSTFDZEFucVRIYlZRNWFwbm50THdDMVZnRi8wODAvcUlnZG91eWxzNUg5RmJTdXdqalJtSkIK",
      "endpoints": [
        "https://github.com/ShanCoder110/pos-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
