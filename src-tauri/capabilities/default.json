{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "process:default",
    "updater:default",
    "allow-list-system-printers",
    "allow-cut-thermal-paper",
    "allow-print-thermal-receipt",
    "allow-print-thermal-test"
  ]
}
